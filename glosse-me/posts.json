---
layout: null
sitemap: false
---
{%- comment -%}
  Compact index used by the tile grid (infinite scroll) and the navigate search.
  Keys: i id, u url, d date, c cover image, w/h its size, n image count,
  y type, x text snippet, g tags, t themes, k categories.
{%- endcomment -%}
[{% for p in site.posts %}{% assign cover = p.images | first %}{"i":{{ p.id | jsonify }},"u":{{ p.url | relative_url | jsonify }},"d":"{{ p.date | date: '%Y-%m-%d' }}"{% if cover %},"c":{{ cover.url | jsonify }},"w":{{ cover.width }},"h":{{ cover.height }},"n":{{ p.images | size }}{% endif %},"y":{{ p.type | jsonify }},"x":{{ p.summary | default: p.content | strip_html | strip_newlines | normalize_whitespace | truncate: 140 | jsonify }},"g":{{ p.tags | jsonify }},"t":{{ p.themes | jsonify }},"k":{{ p.categories | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
